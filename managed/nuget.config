<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for the managed projects (NVorbis, Mono.Cecil). The wasm
     build passes wasm-nuget.config instead (it adds dotnet-experimental). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
